<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.FaceVerify.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/back" />

            <TextView
                style="@style/Text.FaceVerify.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textAllCaps="false"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/connectionPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_connection_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <View
                    android:id="@+id/connectionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/connectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_checking"
                    android:textColor="@color/mist"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.FaceVerify.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_base_url"
            app:boxStrokeColor="@color/teal"
            app:helperTextEnabled="true"
            app:helperText="@string/api_base_url_hint"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputApiUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/device_id"
            app:boxStrokeColor="@color/teal"
            app:helperTextEnabled="true"
            app:helperText="@string/device_id_hint"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/device_token"
            app:boxStrokeColor="@color/teal"
            app:helperTextEnabled="true"
            app:helperText="@string/device_token_hint"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDeviceToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/threshold"
            app:boxStrokeColor="@color/teal"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_access_section"
            android:textColor="@color/mist"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/device_mode_hint"
            android:textColor="@color/mist_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/device_mode_label"
            android:textColor="@color/mist_dim"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/deviceModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/modeKiosk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_mode_kiosk"
                android:textColor="@color/mist" />

            <RadioButton
                android:id="@+id/modeStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_mode_staff"
                android:textColor="@color/mist" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/staff_pin_label"
            app:boxStrokeColor="@color/teal"
            app:endIconMode="password_toggle"
            app:helperText="Default 1234 — for Students / faces"
            app:helperTextEnabled="true"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputStaffPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/admin_pin_label"
            app:boxStrokeColor="@color/teal"
            app:endIconMode="password_toggle"
            app:helperText="Default 9999 — for Settings, delete, edit details"
            app:helperTextEnabled="true"
            app:hintTextColor="@color/mist_dim">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAdminPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:textColor="@color/mist" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.FaceVerify.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRfid"
            style="@style/Widget.FaceVerify.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_rfid_mode" />
    </LinearLayout>
</ScrollView>
