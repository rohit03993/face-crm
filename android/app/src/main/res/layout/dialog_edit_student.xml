<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ink_soft"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/student_id"
        app:boxBackgroundColor="@color/field_bg"
        app:boxStrokeColor="@color/teal"
        app:hintTextColor="@color/mist_dim">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputEditStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textColor="@color/mist" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/student_name"
        app:boxBackgroundColor="@color/field_bg"
        app:boxStrokeColor="@color/teal"
        app:hintTextColor="@color/mist_dim">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputEditStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/mist" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
