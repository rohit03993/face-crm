# Face Verify API
APP_NAME=face-verify-api
APP_ENV=local
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# CRM punch timestamps (IST)
APP_TIMEZONE=Asia/Kolkata

# MySQL (docker-compose maps host 3307 -> container 3306)
DATABASE_URL=mysql+pymysql://face:face@127.0.0.1:3307/face_verify

# Auth
CRM_SERVICE_TOKEN=change-me-crm-service-token
DEVICE_TOKEN_PEPPER=change-me-device-pepper

# Vendor admin: create/list tenants (defaults to CRM_SERVICE_TOKEN if unset)
PLATFORM_ADMIN_TOKEN=

# CRM callback (legacy single-school fallback — prefer per-tenant CRM URLs)
CRM_CALLBACK_URL=http://host.docker.internal/api/face-verify/approve
CRM_CAMERA_PUNCH_URL=http://host.docker.internal/api/face-verify/camera-punch
CRM_CALLBACK_SECRET=change-me-crm-callback-secret

# Face model
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_VERSION=w600k_r50
EMBEDDING_DIM=512
MATCH_THRESHOLD=0.35
VERIFICATION_TIMEOUT_SECONDS=30
CAMERA_PUNCH_COOLDOWN_SECONDS=60

# Storage
STORAGE_DIR=./storage
FACES_DIR=./storage/faces
FAILS_DIR=./storage/fails
